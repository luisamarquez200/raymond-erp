generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@prisma/client-comercial"
}

datasource db {
  provider     = "mysql"
  url          = env("COMERCIAL_R4_DATABASE_URL")
  relationMode = "prisma"
}

// -----------------------------------------------------------------------------
// SEGURIDAD Y AUDITORÍA
// -----------------------------------------------------------------------------

model Usuario {
  id                String   @id @default(cuid()) @db.VarChar(50)
  correo            String   @unique @db.VarChar(150)
  nombre            String?  @db.VarChar(150)
  rol               String   @default("USUARIO") @db.VarChar(50)
  adc_asociado_name String?  @db.VarChar(255)
  auxiliar_name     String?  @db.VarChar(255)
  bloqueado         Boolean  @default(false)
  created_at        DateTime @default(now())
  
  auditorias        Auditoria[]
  documentos        Documento[]

  @@map("usuarios")
}

model Auditoria {
  id              String   @id @default(cuid()) @db.VarChar(50)
  fecha           DateTime @default(now())
  usuario_id      String?  @db.VarChar(50)
  modulo          String   @db.VarChar(100)
  registro_id     String   @db.VarChar(50)
  accion          String   @db.VarChar(50)
  valor_anterior  Json?
  valor_nuevo     Json?
  observaciones   String?  @db.Text

  usuario         Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([modulo, registro_id])
  @@map("auditorias")
}

// -----------------------------------------------------------------------------
// OPERACIÓN
// -----------------------------------------------------------------------------

model Cliente {
  id                String   @id @default(cuid()) @db.VarChar(50)
  codigo_cliente    String?  @unique @db.VarChar(100)
  razon_social      String   @db.VarChar(255)
  rfc               String?  @db.VarChar(100)
  datos_comerciales Json?
  datos_fiscales    Json?
  estado            String   @default("ACTIVO") @db.VarChar(50)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  sitios            Sitio[]
  activos           Activo[]
  rentas            Renta[]
  contratos         Contrato[]
  ordenes           OrdenMensual[]
  tarifas           Tarifa[]

  @@map("clientes")
}

model Sitio {
  id                 String   @id @default(cuid()) @db.VarChar(50)
  cliente_id         String   @db.VarChar(50)
  nombre             String   @db.VarChar(255)
  no_totvs           String?  @db.VarChar(100)
  tienda             String?  @db.VarChar(100)
  direccion          String?  @db.VarChar(255)
  ciudad             String?  @db.VarChar(100)
  estado             String?  @db.VarChar(100)
  cuenta             String?  @db.VarChar(100)
  adc                String?  @db.VarChar(100)
  distribuidor       String?  @db.VarChar(100)
  contacto_operativo Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  cliente            Cliente  @relation(fields: [cliente_id], references: [id])
  activos            Activo[]
  rentas             Renta[]
  contratos          Contrato[]

  @@index([cliente_id])
  @@map("sitios")
}

model Activo {
  id                String   @id @default(cuid()) @db.VarChar(50)
  id_ubiqo          String?  @unique @db.VarChar(100)
  serie             String   @unique @db.VarChar(100)
  tipo              String?  @db.VarChar(100)
  clase             String?  @db.VarChar(100)
  modelo            String?  @db.VarChar(100)
  oach              String?  @db.VarChar(100)
  altura            String?  @db.VarChar(50)
  bc                String?  @db.VarChar(50)
  info_tecnica      Json?

  // Estatus unificado (nomenclatura del archivo maestro)
  // Valores: Activo | Inactivo | Back Up | Inactivo con Cliente | Por Entregar | Por Retirar
  estatus           String   @default("Activo") @db.VarChar(100)

  // Campos legacy mantenidos por compatibilidad (deprecados)
  estado_renta      String   @default("DISPONIBLE") @db.VarChar(50)
  estatus_operativo String   @default("OPERATIVO") @db.VarChar(50)

  propietario       String?  @db.VarChar(100)

  cliente_id        String?  @db.VarChar(50)
  sitio_id          String?  @db.VarChar(50)
  cuenta            String?  @db.VarChar(100)
  adc               String?  @db.VarChar(100)
  distribuidor      String?  @db.VarChar(100)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  cliente           Cliente? @relation(fields: [cliente_id], references: [id])
  sitio             Sitio?   @relation(fields: [sitio_id], references: [id])
  rentas            Renta[]
  ordenes           OrdenMensual[]
  historial_sitios  CambioSitioLog[]
  accesorios        ActivoAccesorio[] @relation("EquipoPrincipal")
  equipo_principal  ActivoAccesorio[] @relation("AccesorioDeEquipo")

  @@index([cliente_id])
  @@index([sitio_id])
  @@index([estatus])
  @@index([estatus, estatus_operativo])
  @@index([adc])
  @@map("activos")
}

// -----------------------------------------------------------------------------
// RENTAS, CONTRATOS Y ÓRDENES
// -----------------------------------------------------------------------------

model Contrato {
  id              String   @id @default(cuid()) @db.VarChar(50)
  numero_contrato String   @unique @db.VarChar(100)
  cliente_id      String   @db.VarChar(50)
  sitio_id        String?  @db.VarChar(50)
  tipo            String?  @db.VarChar(100)
  estado          String   @default("ACTIVO") @db.VarChar(50)
  condiciones     Json?
  fecha_inicio    DateTime @db.Date
  fecha_fin       DateTime @db.Date
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  cliente         Cliente  @relation(fields: [cliente_id], references: [id])
  sitio           Sitio?   @relation(fields: [sitio_id], references: [id])
  rentas          Renta[]
  ordenes         OrdenMensual[]

  @@index([cliente_id])
  @@index([sitio_id])
  @@map("contratos")
}

model Renta {
  id                   String    @id @default(cuid()) @db.VarChar(50)
  orden_compra         String?   @db.VarChar(100)
  cliente_id           String    @db.VarChar(50)
  sitio_id             String    @db.VarChar(50)
  activo_id            String    @db.VarChar(50)
  contrato_id          String?   @db.VarChar(50)

  // Campos de identificación (MANUAL)
  cuenta               String?   @db.VarChar(100)
  adc                  String?   @db.VarChar(100)
  distribuidor         String?   @db.VarChar(100)
  no_registro_totvs    String?   @db.VarChar(100)
  fecha_recepcion      DateTime? @db.Date
  fecha_pedido_totvs   DateTime? @db.Date

  tarifa          Float?
  condiciones     Json?
  periodicidad    String?  @db.VarChar(50)
  comentarios     String?  @db.Text
  // IMPORTADA = creada por carga masiva, VIGENTE = activa, RENOVADA, CANCELADA
  estado          String   @default("VIGENTE") @db.VarChar(50)
  origen          String   @default("MANUAL") @db.VarChar(50) // MANUAL | IMPORTADA

  fecha_inicio    DateTime @db.Date
  fecha_fin       DateTime @db.Date
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  cliente         Cliente   @relation(fields: [cliente_id], references: [id])
  sitio           Sitio     @relation(fields: [sitio_id], references: [id])
  activo          Activo    @relation(fields: [activo_id], references: [id])
  contrato        Contrato? @relation(fields: [contrato_id], references: [id])
  ordenes         OrdenMensual[]
  detalles        DetallesRenta?

  @@index([cliente_id])
  @@index([sitio_id])
  @@index([activo_id])
  @@index([contrato_id])
  @@index([estado, origen])
  @@index([adc])
  @@map("rentas")
}

model DetallesRenta {
  id                     String   @id @default(cuid()) @db.VarChar(50)
  renta_id               String   @unique @db.VarChar(50)

  periodo_cobro          String?  @db.VarChar(50)   // mensual | trimestral | anual
  mes_cobro              String?  @db.VarChar(50)   // "Enero 2026"
  oc_cliente             String?  @db.VarChar(100)
  tipo_renta             String?  @db.VarChar(100)
  moneda                 String   @default("MXN") @db.VarChar(10)
  renta_base             Float?
  renta_real             Float?
  comentarios            String?  @db.Text

  mantenimiento          Boolean  @default(false)
  pago_mantenimiento     Float?

  descuento_dias_caidos  Float    @default(0)
  importe_recuperado     Float    @default(0)

  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  renta                  Renta    @relation(fields: [renta_id], references: [id])

  @@index([renta_id])
  @@map("detalles_renta")
}

model OrdenMensual {
  id              String   @id @default(cuid()) @db.VarChar(50)
  cliente_id      String   @db.VarChar(50)
  contrato_id     String?  @db.VarChar(50)
  renta_id        String?  @db.VarChar(50)
  activo_id       String?  @db.VarChar(50)
  
  periodo         String   @db.VarChar(50) // e.g. "2026-05"
  po              String?  @db.VarChar(100) // Orden de Compra del mes
  tarifa          Float?
  moneda          String?  @db.VarChar(20)
  condiciones     Json?
  // IMPORTADA = creada por carga masiva. Permite edición posterior desde módulo Rentas
  estado          String   @default("IMPORTADA") @db.VarChar(50)
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  cliente         Cliente  @relation(fields: [cliente_id], references: [id])
  contrato        Contrato? @relation(fields: [contrato_id], references: [id])
  renta           Renta?   @relation(fields: [renta_id], references: [id])
  activo          Activo?  @relation(fields: [activo_id], references: [id])

  @@index([cliente_id])
  @@index([contrato_id])
  @@index([renta_id])
  @@index([activo_id])
  @@index([activo_id, periodo])
  @@unique([activo_id, periodo, po])
  @@map("ordenes_mensuales")
}

// -----------------------------------------------------------------------------
// COMERCIAL
// -----------------------------------------------------------------------------

model Tarifa {
  id              String   @id @default(cuid()) @db.VarChar(50)
  cliente_id      String?  @db.VarChar(50)
  servicio        String?  @db.VarChar(100)
  clase           String?  @db.VarChar(100)
  modelo          String?  @db.VarChar(100)
  tarifa          Float
  moneda          String   @default("MXN") @db.VarChar(10)
  vigencia_inicio DateTime @db.Date
  vigencia_fin    DateTime? @db.Date
  observaciones   String?  @db.Text
  
  created_at      DateTime @default(now())

  cliente         Cliente? @relation(fields: [cliente_id], references: [id])

  @@index([cliente_id])
  @@map("tarifas")
}

// -----------------------------------------------------------------------------
// LOGS Y OTROS
// -----------------------------------------------------------------------------

model CambioSitioLog {
  id                String   @id @default(cuid()) @db.VarChar(50)
  activo_id         String   @db.VarChar(50)
  sitio_anterior_id String?  @db.VarChar(50)
  sitio_nuevo_id    String   @db.VarChar(50)
  motivo            String?  @db.Text
  aprobado          Boolean  @default(true)
  fecha             DateTime @default(now())
  usuario_id        String?  @db.VarChar(50)

  activo            Activo   @relation(fields: [activo_id], references: [id])

  @@index([activo_id])
  @@map("cambios_sitio")
}

model Documento {
  id                  String   @id @default(cuid()) @db.VarChar(50)
  tipo_documento      String   @db.VarChar(100)
  modulo_relacionado  String   @db.VarChar(100)
  registro_id         String   @db.VarChar(50)
  archivo_url         String   @db.Text
  nombre_archivo      String   @db.VarChar(255)
  formato             String?  @db.VarChar(50)
  tamano_kb           Int?
  fecha               DateTime @default(now())
  usuario_id          String?  @db.VarChar(50)

  usuario             Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([modulo_relacionado, registro_id])
  @@index([usuario_id])
  @@map("documentos")
}

// -----------------------------------------------------------------------------
// ACCESORIOS DE EQUIPOS (Baterías / Cargadores)
// -----------------------------------------------------------------------------

model ActivoAccesorio {
  id            String  @id @default(cuid()) @db.VarChar(50)
  activo_id     String  @db.VarChar(50)  // El equipo principal (montacargas, reach, etc.)
  accesorio_id  String  @db.VarChar(50)  // La batería o cargador (otro Activo)
  tipo_relacion String  @db.VarChar(50)  // "BATERIA" | "CARGADOR"
  cantidad      Int     @default(1)
  notas         String? @db.Text

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  activo        Activo  @relation("EquipoPrincipal", fields: [activo_id], references: [id])
  accesorio     Activo  @relation("AccesorioDeEquipo", fields: [accesorio_id], references: [id])

  @@unique([activo_id, accesorio_id])
  @@index([activo_id])
  @@index([accesorio_id])
  @@map("activo_accesorios")
}

model CargaMasivaLog {
  id                String   @id @default(cuid()) @db.VarChar(50)
  modulo            String   @db.VarChar(100)
  fecha             DateTime @default(now())
  usuario_id        String?  @db.VarChar(50)
  archivo_url       String?  @db.Text
  total_registros   Int      @default(0)
  procesados        Int      @default(0)
  errores           Int      @default(0)
  resumen           Json?

  @@map("cargas_masivas_logs")
}

// -----------------------------------------------------------------------------
// TIPO DE CAMBIO MENSUAL (MXN / USD) & TRAZABILIDAD
// -----------------------------------------------------------------------------

model TipoCambioMensual {
  id                      String   @id @default(cuid()) @db.VarChar(50)
  year                    Int
  month                   Int
  tipo_cambio             Float
  activo                  Boolean  @default(true)
  usuario_modificacion_id String?  @db.VarChar(50)
  usuario_nombre          String?  @db.VarChar(150)
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  historial               TipoCambioHistorial[]

  @@unique([year, month])
  @@index([year, month])
  @@map("tipos_cambio_mensuales")
}

model TipoCambioHistorial {
  id                        String             @id @default(cuid()) @db.VarChar(50)
  tipo_cambio_id            String             @db.VarChar(50)
  year                      Int
  month                     Int
  valor_anterior            Float?
  valor_nuevo               Float
  usuario_id                String?            @db.VarChar(50)
  usuario_nombre            String?            @db.VarChar(150)
  motivo                    String?            @db.Text
  fecha                     DateTime           @default(now())

  tipoCambioMensual         TipoCambioMensual  @relation(fields: [tipo_cambio_id], references: [id], onDelete: Cascade)

  @@index([tipo_cambio_id])
  @@index([year, month])
  @@map("tipos_cambio_historial")
}

// -----------------------------------------------------------------------------
// FACTURACIÓN (Gerente)
// -----------------------------------------------------------------------------

model FacturacionMensual {
  id              String   @id @default(cuid()) @db.VarChar(50)
  periodo         String   @db.VarChar(50) // e.g. "2026-08"
  moneda          String   @db.VarChar(20) // MXN o USD
  monto           Float    @default(0)
  
  updated_by_id   String?  @db.VarChar(100) // ID del usuario (gerente) que lo actualizó
  updated_by_name String?  @db.VarChar(150) // Nombre del gerente
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  @@unique([periodo, moneda])
  @@index([periodo])
  @@map("facturacion_mensual")
}
